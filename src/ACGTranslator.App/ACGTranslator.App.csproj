<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ACGTranslator.App</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Resources\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\model-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="ACGTranslator.Tests" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
