<Window x:Class="ACGTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,2" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock Text="字幕与翻译设置" FontSize="22" FontWeight="SemiBold" />

        <TextBlock Text="音频与识别" Style="{StaticResource Section}" />
        <TextBlock Text="系统声音输出设备" Style="{StaticResource Label}" />
        <ComboBox x:Name="OutputDeviceBox" Height="28" DisplayMemberPath="Name" AutomationProperties.Name="系统声音输出设备" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="语音语言" Style="{StaticResource Label}" />
                <ComboBox x:Name="LanguageBox" Height="28" SelectedValuePath="Tag" AutomationProperties.Name="语音语言">
                    <ComboBoxItem Content="自动检测（日语/英语）" Tag="auto" />
                    <ComboBoxItem Content="日语" Tag="ja" />
                    <ComboBoxItem Content="英语" Tag="en" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="识别设备" Style="{StaticResource Label}" />
                <ComboBox x:Name="DeviceBox" Height="28" SelectedValuePath="Tag" AutomationProperties.Name="识别设备">
                    <ComboBoxItem Content="自动选择（有可用运行库时使用显卡）" Tag="auto" />
                    <ComboBoxItem Content="CPU（兼容性最好）" Tag="cpu" />
                    <ComboBoxItem Content="CUDA（需要 NVIDIA 运行库）" Tag="cuda" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="SegmentLabel" Style="{StaticResource Label}" />
        <Slider x:Name="SegmentSlider" Minimum="2" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" AutomationProperties.Name="最长片段" />

        <TextBlock Text="字幕窗口" Style="{StaticResource Section}" />
        <Button Content="打开模型管理" HorizontalAlignment="Left" Click="ModelManager_Click" />
        <TextBlock x:Name="ModelLabel" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,2" />
        <CheckBox x:Name="ShowSourceBox" Content="显示原文" Margin="0,8,0,4" />
        <CheckBox x:Name="AlwaysOnTopBox" Content="窗口始终置顶" Margin="0,4" />
        <CheckBox x:Name="SaveHistoryBox" Content="保存字幕历史" Margin="0,4" />
        <TextBlock x:Name="FontSizeLabel" Style="{StaticResource Label}" />
        <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" AutomationProperties.Name="中文字号" />
        <TextBlock x:Name="OpacityLabel" Style="{StaticResource Label}" />
        <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" AutomationProperties.Name="窗口透明度" />

        <Expander Header="高级：本地运行环境" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Python 解释器（留空使用项目 .venv）" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button Content="浏览…" DockPanel.Dock="Right" Click="BrowsePython_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="PythonBox" Height="26" VerticalContentAlignment="Center" AutomationProperties.Name="Python 解释器路径" />
                </DockPanel>
                <TextBlock Text="Whisper 模型目录（留空使用 models\whisper-base）" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button Content="浏览…" DockPanel.Dock="Right" Click="BrowseModel_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="ModelBox" Height="26" VerticalContentAlignment="Center" AutomationProperties.Name="Whisper 模型目录" />
                </DockPanel>
                <TextBlock x:Name="DataPathText" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" Click="CancelButton_Click" />
            <Button Content="保存" IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
