<Window x:Class="ACGTranslator.ModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型管理" Width="860" Height="560" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="模型管理" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="下载和删除只影响本机模型文件；运行时不会自动联网。下载需要网络。" Foreground="Gray" Margin="0,4,0,12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,12,0" />
            <Button Content="刷新" Click="RefreshButton_Click" />
            <Button Content="设为当前" Click="UseButton_Click" />
            <Button Content="下载/安装" Click="InstallButton_Click" />
            <Button Content="删除" Click="DeleteButton_Click" />
            <Button Content="关闭" IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
        <ListView x:Name="ModelsList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="80" />
                    <GridViewColumn Header="类型" DisplayMemberBinding="{Binding KindName}" Width="80" />
                    <GridViewColumn Header="模型" DisplayMemberBinding="{Binding Name}" Width="190" />
                    <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                    <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Description}" Width="380" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
