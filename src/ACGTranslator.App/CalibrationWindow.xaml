<Window x:Class="ACGTranslator.CalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="识别自动校准" Width="1040" Height="800" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterOwner" Closing="Window_Closing" Background="#F6F7F9" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid Margin="18" Background="#F6F7F9">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="Configuration">
   <TextBlock Text="用你的游戏录音校准识别设置" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="比较本地已安装模型、CPU/GPU 与解码搜索宽度；独立样本验证通过后才应用。翻译模型、切句长度和接话增强保持当前设置。" TextWrapping="Wrap" Margin="0,8"/>
   <DockPanel><Button Content="选择原文 / 清单" Click="PickInput_Click" DockPanel.Dock="Right"/><TextBox x:Name="InputText" IsReadOnly="True" Margin="0,4" ToolTip="支持 UTF-8 SRT，或采集器导出的 JSONL/CSV；多个清单可一起选择"/></DockPanel>
   <DockPanel><Button Content="选择对应录音" Click="PickAudio_Click" DockPanel.Dock="Right"/><Button Content="清除录音" Click="ClearAudio_Click" DockPanel.Dock="Right"/><TextBox x:Name="AudioText" IsReadOnly="True" Margin="0,4" ToolTip="SRT 必须提供对应录音；清单自身包含音频路径，不需要额外选择"/></DockPanel>
   <WrapPanel Margin="0,5">
    <TextBlock Text="SRT 原文语言" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Width="100" Margin="6" SelectedIndex="0"><ComboBoxItem Content="日语" Tag="ja"/><ComboBoxItem Content="英语" Tag="en"/></ComboBox>
    <TextBlock Text="优化偏好" VerticalAlignment="Center"/><ComboBox x:Name="ModeBox" Width="140" Margin="6" SelectedIndex="0"><ComboBoxItem Content="准确率与速度平衡" Tag="balanced"/><ComboBoxItem Content="准确率优先" Tag="accuracy"/><ComboBoxItem Content="速度优先" Tag="speed"/></ComboBox>
    <TextBlock Text="最长运行（分钟）" VerticalAlignment="Center"/><ComboBox x:Name="BudgetBox" Width="70" Margin="6" SelectedIndex="1"><ComboBoxItem Content="5"/><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox>
   </WrapPanel>
   <CheckBox x:Name="VerifiedBox" Content="已核对原文、配音和时间对应关系，并排除了没有配音的句子" Margin="4"/>
   <CheckBox x:Name="AutoApplyBox" Content="验证通过后自动应用并备份原设置；不通过则保留原设置" IsChecked="True" Margin="4"/>
   <TextBlock x:Name="CandidateText" Text="加载本地配置…" TextWrapping="Wrap" Foreground="#555555" Margin="4,8"/>
  </StackPanel>
  <WrapPanel Grid.Row="1"><Button x:Name="RunButton" Content="开始自动校准" Click="Run_Click"/><Button x:Name="CancelButton" Content="取消（不应用）" IsEnabled="False" Click="Cancel_Click"/><TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="10" TextWrapping="Wrap"/></WrapPanel>
  <TextBox Grid.Row="2" x:Name="ResultsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/>
  <WrapPanel Grid.Row="3">
   <ComboBox x:Name="RunsBox" Width="350" Margin="4"/>
   <Button Content="查看该次报告" Click="OpenReport_Click"/>
   <Button x:Name="RestoreButton" Content="恢复该次校准前设置" Click="Restore_Click"/>
  </WrapPanel>
 </Grid>
</Window>
